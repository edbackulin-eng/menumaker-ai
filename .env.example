# =============================================================================
# MenuMaker AI — приклад файлу середовища
# Скопіюйте цей файл у .env.local та заповніть реальними значеннями.
# НІКОЛИ не комітьте .env.local та інші файли з реальними секретами.
# =============================================================================

# --- Supabase ------------------------------------------------------------
# URL проєкту Supabase (Settings → API у Supabase Dashboard).
# Публічна змінна — потрапляє в браузерний бандл.
NEXT_PUBLIC_SUPABASE_URL=

# Публічний anon-ключ Supabase (Settings → API). Безпечний для браузера,
# доступ до даних обмежується Row Level Security на стороні бази.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role ключ Supabase (Settings → API). Обходить RLS — використовувати
# ЛИШЕ на сервері (Route Handlers, Server Actions). Ніколи не передавати в клієнт.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (CAPTCHA на формі реєстрації) --------------------
# Публічний site key віджета (Cloudflare Dashboard → Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Секретний ключ для серверної перевірки токена через Cloudflare siteverify API.
TURNSTILE_SECRET_KEY=

# --- AI провайдер (Stage 6) -------------------------------------------------
# Який AIProvider використовує services/ai/provider-factory.ts. Наразі
# підтримується лише "anthropic"; значення за замовчуванням теж "anthropic".
AI_PROVIDER=anthropic

# API-ключ Anthropic Console (console.anthropic.com → Settings → API Keys).
# Використовується лише на сервері (services/ai) — модель claude-haiku-4-5.
# Інструкція для отримання ключа й поповнення балансу: docs/anthropic-setup.md.
ANTHROPIC_API_KEY=

# --- Фото-провайдер (Stage 13 — пошук фото страв) --------------------------
# Який PhotoProvider використовує services/photos/provider-factory.ts. Наразі
# підтримується лише "pexels"; значення за замовчуванням теж "pexels".
PHOTO_PROVIDER=pexels

# API-ключ Pexels (pexels.com/api → Your API Key). Використовується лише на
# сервері (services/photos) — пошук і завантаження фото страв.
PEXELS_API_KEY=

# --- Stripe (Stage 9 — ПРИЗУПИНЕНО, див. docs/payments-integration.md) -----
# Готовий код лежить у гілці stage-9-stripe-payments-paused, не в main.
# Секретний ключ Stripe для серверних викликів API.
STRIPE_SECRET_KEY=

# Секрет для перевірки підпису вебхуків Stripe.
STRIPE_WEBHOOK_SECRET=

# --- Застосунок ------------------------------------------------------------
# Публічна базова URL-адреса застосунку (для посилань, редиректів, OG-тегів).
# Локально: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Демо-режим (портфоліо) -------------------------------------------------
# DEMO_MODE=true вмикає безпечний демо-режим: усі «важкі» серверні операції
# (AI, Pexels, експорт, аплоуди, будь-які записи в БД/Storage, авторизація,
# уся адмінка) блокуються НА БЕКЕНДІ й повертають ввічливу відмову. Живими
# лишаються тільки read-only перегляди (список меню, одне меню, дашборд) та
# публічні сторінки /m/[slug] — щоб показати готовий приклад.
#
# За замовчуванням вимкнено (порожньо або будь-що, крім "true") — прод працює
# як звичайно. Заслоном є САМЕ цей прапорець, а не порожні ключі.
#
# У демо-оточенні можна лишати порожніми ANTHROPIC_API_KEY, PEXELS_API_KEY,
# TURNSTILE_SECRET_KEY та NEXT_PUBLIC_TURNSTILE_SITE_KEY — код їх не читає, бо
# заслон спрацьовує раніше (env-конфіги валідуються лениво). Supabase-змінні
# (URL/ANON, за потреби SERVICE_ROLE) мають лишатися реальними — на них тримається
# read-only приклад меню.
DEMO_MODE=false
