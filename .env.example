# =============================================================================
# MenuMaker AI — приклад файлу середовища
# Скопіюйте цей файл у .env.local та заповніть реальними значеннями.
# НІКОЛИ не комітьте .env.local та інші файли з реальними секретами.
# =============================================================================

# --- Supabase ------------------------------------------------------------
# URL проєкту Supabase (Settings → API у Supabase Dashboard).
# Публічна змінна — потрапляє в браузерний бандл.
NEXT_PUBLIC_SUPABASE_URL=

# Публічний anon-ключ Supabase (Settings → API). Безпечний для браузера,
# доступ до даних обмежується Row Level Security на стороні бази.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role ключ Supabase (Settings → API). Обходить RLS — використовувати
# ЛИШЕ на сервері (Route Handlers, Server Actions). Ніколи не передавати в клієнт.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (CAPTCHA на формі реєстрації) --------------------
# Публічний site key віджета (Cloudflare Dashboard → Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Секретний ключ для серверної перевірки токена через Cloudflare siteverify API.
TURNSTILE_SECRET_KEY=

# --- AI провайдер ----------------------------------------------------------
# API-ключ провайдера, що генерує контент меню (OpenAI/Anthropic/інший).
# Використовується лише на сервері (services/ai).
AI_PROVIDER_API_KEY=

# --- Stripe ------------------------------------------------------------
# Секретний ключ Stripe для серверних викликів API (підключення — етап 9).
STRIPE_SECRET_KEY=

# Секрет для перевірки підпису вебхуків Stripe (підключення — етап 9).
STRIPE_WEBHOOK_SECRET=

# --- Застосунок ------------------------------------------------------------
# Публічна базова URL-адреса застосунку (для посилань, редиректів, OG-тегів).
# Локально: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
